{
  "description": "context-watch: when the session's context passes the configured token thresholds, the model stops and hands you a prompt for a new session.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch-shim.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_watch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch-shim.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_watch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch-shim.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_watch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/context-watch-shim.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_watch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
